# Extra settings for running the stack under automated tests (scripts/dev-stack.sh start --env e2e/stack.env).
# Points payment-service at the local Mercado Pago test double. Not for real use.
MERCADOPAGO_ACCESS_TOKEN=TEST-e2e-test-double
MERCADOPAGO_WEBHOOK_SECRET=e2e-webhook-secret
MERCADOPAGO_API_BASE_URL=http://127.0.0.1:9099
MP_WEBHOOK_URL=http://localhost:8080/api/payments/webhook
MP_RECONCILE_INTERVAL_MS=3600000
AUTH_RATE_LIMIT_PER_MINUTE=100000
