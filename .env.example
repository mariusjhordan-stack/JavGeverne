# Copy to .env (never commit it) or run scripts/gen-env.sh, which fills the secrets with random values.

# ---- PostgreSQL (one instance, one database per service) ----
POSTGRES_USER=cronos
POSTGRES_PASSWORD=__GENERATE_24__

# ---- Secrets shared between services (required, no defaults) ----
# HS512 signing key for access tokens: at least 64 characters. Used by auth-service and api-gateway.
JWT_SECRET=__GENERATE_64__
# Proves a request comes from the gateway or another service: at least 32 characters.
INTERNAL_API_TOKEN=__GENERATE_48__

# ---- First administrator (created on startup if missing; password 12+ characters) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__GENERATE_20__

# ---- Public URLs ----
# Where customers reach the storefront. Used for Mercado Pago return URLs and CORS.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ---- Mercado Pago (server side only; leave empty to run without online payment) ----
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Public HTTPS URL of the webhook, e.g. https://cronosgeneve.com/api/payments/webhook
MP_WEBHOOK_URL=
# Optional overrides; default to FRONTEND_URL/checkout/{success,failure,pending}
MP_SUCCESS_URL=
MP_FAILURE_URL=
MP_PENDING_URL=

# ---- E-mail (leave MAIL_HOST empty to record notifications without sending) ----
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# ---- Tuning ----
ORDER_RESERVATION_TTL_MINUTES=60
AUTH_RATE_LIMIT_PER_MINUTE=20
